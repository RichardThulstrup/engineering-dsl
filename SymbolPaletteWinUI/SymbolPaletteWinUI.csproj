<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.19041.41</WindowsSdkPackageVersion> 
    <RootNamespace>SymbolPaletteWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- If you use Visual Studio 2026 / Windows App SDK 2.0, you may upgrade this to 2.0.1. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
  </ItemGroup>

  <!-- Tab-selector icons.  Every file under Assets/Icons/ is bundled
       next to the app as Content, so the code can load it via the
       ms-appx:///Assets/Icons/<file> URI.  To add or change a tab icon,
       drop an .svg (preferred) or .png into Assets/Icons/ and point the
       group's IconFile at it in SymbolRepository.cs — the wildcard here
       means no .csproj edit is needed for the file itself. -->
  <ItemGroup>
    <Content Include="Assets\Icons\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\MathEditor\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>  
</Project>

