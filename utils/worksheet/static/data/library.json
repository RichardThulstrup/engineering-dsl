  {"name": "Engineering", "sections": [
   {"heading": "Operators & assignment", "entries": [
    {"text": "‖", "desc": "parallel — DSL operator for parallel resistance: R1 ‖ R2"},
    {"text": "∠", "desc": "angle / phase — DSL phasor operator: 5 ∠ 30°"},
    {"text": "±", "desc": "plus-minus — produces a ±-tolerance Range"},
    {"text": ":=", "desc": "math-style assignment — DSL rewrites to = (canonical form)"},
    {"text": "←", "desc": "alternative assignment glyph — also rewrites to ="},
    {"text": "→", "desc": "lambda / def return-type arrow"},
    {"text": "▸", "desc": "display-preference operator — value ▸ target. Inert under arithmetic; sets how a value is shown (unit, integer base, or axis label). Apply on output, at the edge of an expression."},
    {"text": "⌊", "desc": "left floor bracket"},
    {"text": "⌋", "desc": "right floor bracket"},
    {"text": "⌈", "desc": "left ceiling bracket"},
    {"text": "⌉", "desc": "right ceiling bracket"},
    {"text": "∑", "desc": "summation — n-ary sum operator (= Σ; both forms work in DSL)"},
    {"text": "∏", "desc": "product — n-ary product operator (= Π; both forms work in DSL)"},
    {"text": "Γ", "desc": "gamma function"},
    {"text": "·", "desc": "multiplication dot"},
    {"text": "×", "desc": "multiplication cross"},
    {"text": "∥", "desc": "parallel (U+2225) — accepted as an alias of ‖"},
    {"text": "≔", "desc": "assignment glyph (U+2254) — same as :="}
   ]},
   {"heading": "Intervals (±) and phasors (∠)", "entries": [
    {"text": "100 Ω ± 5%", "desc": "a % (or ‰) tolerance is RELATIVE to the centre — (95 Ω ‥ 105 Ω)"},
    {"text": "‥", "desc": "closed interval from its ends — (95 ‥ 105) is what ± prints; pasteable"},
    {"text": "▸ plusminus", "desc": "show an interval as centre ± half-width: 100 Ω ± 5 Ω"},
    {"text": "▸ percent", "desc": "show an interval as centre ± tolerance in %: 100 Ω ± 5.00%"},
    {"text": "▸ permille", "desc": "show an interval as centre ± tolerance in ‰"},
    {"text": "approx(, , sf=True)", "desc": "≈ to the stated precision — equal when both round to the smaller sig-fig count"},
    {"text": "5.0 ∠ 30°", "desc": "phasor literal — prints back as 5.0 ∠ 30°"},
    {"text": "polar()", "desc": "display a complex value in polar form (magnitude ∠ angle°)"},
    {"text": "rect()", "desc": "display a complex value in rectangular a+bj form"},
    {"text": "▸ deg", "desc": "read an angle (radians) back in degrees: asin(0.5) ▸ deg = 30 deg"}
   ]},
   {"heading": "Vectors and tables", "entries": [
    {"text": "‖‖", "desc": "norm — put the vector between the bars: ‖v‖ (unit-aware)"},
    {"text": "norm()", "desc": "Euclidean norm of a list, [] N array or sympy vector"},
    {"text": "dot(, )", "desc": "dot product, unit-aware: dot([1,2,3] N, [4,5,6] m) = 32 J"},
    {"text": "cross(, )", "desc": "cross product of two 3-vectors, unit-aware"},
    {"text": "interp(, , )", "desc": "table lookup — interp(x, xs, ys), linear, unit-aware; extrapolate=True continues the ends"}
   ]},
   {"heading": "Prefixes & common glyphs", "entries": [
    {"text": "Ω", "desc": "ohm — electrical resistance unit"},
    {"text": "μ", "desc": "micro prefix (= 1e-6)"},
    {"text": "ℏ", "desc": "reduced Planck constant (h-bar)"},
    {"text": "ε", "desc": "small quantity / permittivity"}
   ]},
   {"heading": "Temperature — absolute scales", "entries": [
    {"text": "°", "desc": "degree — postfix angle operator: 30° → radians. A BARE ° is an angle; °C/°F/°R are temperatures."},
    {"text": "°C", "desc": "degree Celsius — absolute. 22 °C is stored as 295.15 K (offset applied)."},
    {"text": "°F", "desc": "degree Fahrenheit — absolute. 72 °F is stored as 295.37 K."},
    {"text": "°R", "desc": "degree Rankine — absolute. Rankine's zero is absolute zero, so °R = K × 5/9 (no offset)."}
   ]},
   {"heading": "Temperature — delta (difference) units", "entries": [
    {"text": "ΔK", "desc": "delta-kelvin — a temperature DIFFERENCE of 1 K (no offset)."},
    {"text": "ΔC", "desc": "delta-Celsius — a temperature DIFFERENCE; 1 ΔC = 1 K. Use for changes, e.g. ΔT := 60 ΔC."},
    {"text": "ΔF", "desc": "delta-Fahrenheit — a temperature DIFFERENCE; 1 ΔF = 5/9 K."},
    {"text": "ppm/°C", "desc": "per-degree coefficient — °C used as a unit (after /) is a delta. e.g. 100 ppm/°C · ΔT."}
   ]}
  ]},
  {"name": "Sets", "sections": [
   {"heading": "Membership", "entries": [
    {"text": "∅", "desc": "empty set — translates to set() (NOT {}, which is an empty dict in Python)"},
    {"text": "∈", "desc": "element of — A ∈ B becomes A in B"},
    {"text": "∉", "desc": "not element of — A ∉ B becomes A not in B"},
    {"text": "∋", "desc": "contains — A ∋ x becomes x in A (operands swapped)"},
    {"text": "∌", "desc": "does not contain — A ∌ x becomes x not in A (swapped)"}
   ]},
   {"heading": "Operations", "entries": [
    {"text": "∩", "desc": "intersection — A ∩ B becomes A & B"},
    {"text": "∪", "desc": "union — A ∪ B becomes A | B"},
    {"text": "∖", "desc": "set difference (U+2216 SET MINUS, not backslash) — A ∖ B becomes A - B"},
    {"text": "△", "desc": "symmetric difference — A △ B becomes A ^ B"},
    {"text": "⊕", "desc": "alternate symmetric-difference glyph — same as △"},
    {"text": "|{1, 2, 3}|", "desc": "cardinality — |S| gives the number of elements. The |…| bars are abs() for a number, len() for a set."}
   ]},
   {"heading": "Subset / superset", "entries": [
    {"text": "⊆", "desc": "subset or equal — A ⊆ B becomes A <= B"},
    {"text": "⊇", "desc": "superset or equal — A ⊇ B becomes A >= B"},
    {"text": "⊂", "desc": "proper subset (strict) — A ⊂ B becomes A < B"},
    {"text": "⊃", "desc": "proper superset (strict) — A ⊃ B becomes A > B"}
   ]},
   {"heading": "Constructors", "entries": [
    {"text": "set()", "desc": "empty set — same as ∅"},
    {"text": "set([])", "desc": "set from iterable"},
    {"text": "frozenset()", "desc": "immutable set"},
    {"text": "{1, 2, 3}", "desc": "set literal — at least one element required"},
    {"text": "{x for x ∈ S}", "desc": "set comprehension"},
    {"text": "{x for x ∈ S if }", "desc": "set comprehension with filter"}
   ]}
  ]},
