    {"text": "{:  for  in }", "desc": "dict comprehension (key:value)"},
    {"text": "( for  in )", "desc": "generator expression"},
    {"text": "range()", "desc": "range with stop only"},
    {"text": "range(, )", "desc": "range(start, stop)"},
    {"text": "range(, , )", "desc": "range(start, stop, step)"}
   ]}
  ]},
  {"name": "Numbers", "sections": [
   {"heading": "Base-suffixed integers", "entries": [
    {"text": "1010₂", "desc": "binary literal — subscript-2 says \"base 2\"."},
    {"text": "11111111₂", "desc": "binary — eight bits."},
    {"text": "17₈", "desc": "octal — subscript-8."},
    {"text": "123₈", "desc": "octal literal."},
    {"text": "0₁₀", "desc": "explicit base-10 — rewrites verbatim."},
    {"text": "1A₁₆", "desc": "hex — digit-led, always safe."},
    {"text": "FF₁₆", "desc": "hex (letter-led) — works for base 16 because F is a hex digit."},
    {"text": "0FF₁₆", "desc": "hex with a leading 0 — the always-safe form for a letter-led literal."},
    {"text": "100₃₆", "desc": "base-36, digit-led — letters a–z map to 10–35."},
    {"text": "radix(, )", "desc": "function form for any base 2–36 — use this when a literal would be letter-led."}
   ]},
   {"heading": "Real & complex", "entries": [
    {"text": "3+2i", "desc": "complex using sympy's imaginary unit — gives 3 + 2*I (symbolic-friendly)"},
    {"text": "3+2j", "desc": "complex using Python's native imaginary unit — gives (3+2j) (numeric)"},
    {"text": "1_000_000", "desc": "PEP 515 underscore separator (improves readability for big numbers)"},
    {"text": "π", "desc": "pi — exact symbolic constant"},
    {"text": "∞", "desc": "infinity — math.inf"},
    {"text": "e", "desc": "Euler's number"}
   ]},
   {"heading": "Exact & rational", "entries": [
    {"text": "_R('0.1')", "desc": "exact rational from decimal string — sympy Rational, e.g. 1/10"},
    {"text": "_R('1/7')", "desc": "exact rational from fraction string — sympy Rational(1, 7)"},
    {"text": "Rational(, )", "desc": "sympy rational; Rational(1, 7) = 1/7"},
    {"text": "exact()", "desc": "wrap value as exact (sf=∞) — used for unit constants"},
    {"text": "measured(, )", "desc": "wrap value with explicit sigfig count, e.g. measured(120, 3)"}
   ]},
   {"heading": "Mode switches", "entries": [
    {"text": "set_decimal_literals(True)", "desc": "make decimal literals like 0.1 evaluate as Rational"},
    {"text": "set_decimal_literals(False)", "desc": "restore ordinary float literals (default)"}
   ]}
  ]},
  {"name": "Various", "sections": [
   {"heading": "Pretty print (toolkit)", "entries": [
    {"text": "pp()", "desc": "symbolic pretty-print; sympy values render with ⋅ and Greek"},
    {"text": "pn()", "desc": "numeric pretty-print; sympy values evaluate to numbers"}
   ]},
   {"heading": "Built-ins", "entries": [
    {"text": "print()", "desc": "stdlib print — note: shows an empty set as set(), not ∅ (it calls str()). Use pp() or print(fmt(x)) for the ∅ glyph."},
    {"text": "type()", "desc": "type of an object"},
    {"text": "len()", "desc": "length of a sequence / collection"},
    {"text": "abs()", "desc": "absolute value"},
    {"text": "round(, )", "desc": "round(x, n) — works on DSL values and keeps the unit: round(1.2345 V, 2) = 1.23 V"},
    {"text": "sum()", "desc": "sum of an iterable; sum([1,2,3]) = 6"},
    {"text": "min()", "desc": "minimum"},
    {"text": "max()", "desc": "maximum"},
    {"text": "isinstance(, )", "desc": "type check"},
    {"text": "hasattr(, '')", "desc": "check for attribute by name"},
    {"text": "getattr(, '')", "desc": "get attribute by name"},
    {"text": "dir()", "desc": "list attributes / methods of an object"},
    {"text": "help()", "desc": "show help (docstring + signature)"}
   ]},
   {"heading": "Toolkit helpers", "entries": [
    {"text": "in_units(, )", "desc": "express value in target units; in_units(v, mm/s)"},
    {"text": "sigfigs_of()", "desc": "return sigfig count of a Sig"},
    {"text": "exact()", "desc": "make value exact (sf=∞)"},
    {"text": "measured(, )", "desc": "tag value with explicit sigfig count"},
    {"text": "fmt()", "desc": "string form of a value, showing an empty set as ∅ (for the print() path)."},
    {"text": "radix(, )", "desc": "display an integer in any base 2–36."},
    {"text": "register_radix(\"\", )", "desc": "register a custom integer-display format."},
    {"text": "from_degC()", "desc": "absolute temperature from a Celsius reading → Kelvin Physical."},
    {"text": "from_degF()", "desc": "absolute temperature from a Fahrenheit reading → Kelvin Physical."}
   ]},
   {"heading": "Date / time (input formats)", "entries": [
    {"text": "\"today\"ₜᵢₘₑ", "desc": "today's date — rewrites to iso(\"today\") → date.today()"},
    {"text": "\"now\"ₜᵢₘₑ", "desc": "current local datetime — iso(\"now\")"},
    {"text": "\"utcnow\"ₜᵢₘₑ", "desc": "current UTC datetime — iso(\"utcnow\")"},
    {"text": "\"2026-05-10\"ₜᵢₘₑ", "desc": "ISO date — fill in the date you want"},
    {"text": "\"2026-05-10T14:30:00\"ₜᵢₘₑ", "desc": "ISO datetime — date + T + time"},
    {"text": "\"2026-05-10T14:30:00Z\"ₜᵢₘₑ", "desc": "ISO datetime in UTC — Z suffix"},
    {"text": "\"14:30:00\"ₜᵢₘₑ", "desc": "ISO time-of-day — date will be today by default"},
    {"text": "\"PT1H30M\"ₜᵢₘₑ", "desc": "ISO 8601 duration — 1 hour 30 minutes"},
    {"text": "\"P1Y6M\"ₜᵢₘₑ", "desc": "ISO 8601 duration — 1 year 6 months"},
    {"text": "\"PT15M30S\"ₜᵢₘₑ", "desc": "ISO 8601 duration — 15 minutes 30 seconds"}
   ]},
   {"heading": "Date / time — durations", "entries": [
    {"text": "\"PT90M\"ₜᵢₘₑ ▸ hour", "desc": "a timedelta read in a time unit — 1.5 hour"},
    {"text": "\"-PT5M\"ₜᵢₘₑ", "desc": "signed durations parse; fractional too (\"PT1.5H\")"},
    {"text": "iso()", "desc": "parse or format ISO 8601 — whole years/months/weeks round-trip (P1Y)"}
   ]},
   {"heading": "Date / time (functions)", "entries": [
    {"text": "datetime.now()", "desc": "current local datetime — stdlib form"},
    {"text": "datetime.today()", "desc": "today's date as datetime"},
    {"text": "datetime(, , )", "desc": "specific date: datetime(year, month, day)"},
    {"text": "timedelta(days=)", "desc": "time difference; days/seconds/hours kwargs"},
    {"text": "time.time()", "desc": "Unix timestamp (seconds since 1970)"}
   ]},
   {"heading": "Roman numerals (input)", "entries": [
    {"text": "\"MMXXVI\"ᵣₒₘₑ", "desc": "Roman-numeral literal → int; \"MMXXVI\" reads as 2026."},
    {"text": "\"MCMXCIV\"ᵣₒₘₑ", "desc": "subtractive form — MCMXCIV → 1994."},
    {"text": "\"IIII\"ᵣₒₘₑ", "desc": "additive form — IIII → 4 (the traditional clock-face spelling)."},
    {"text": "\"\"ᵣₒₘₑ", "desc": "blank Roman literal — fill in the numeral between the quotes."},
    {"text": "from_roman(\"\")", "desc": "function form — Roman-numeral string → int, callable directly."}
   ]},
   {"heading": "Whitespace characters", "entries": [
    {"text": "⇥", "desc": "tab — pastes ⇥ (U+21E5); the DSL turns it into a tab", "detail": "Inserts the tab glyph ⇥. The DSL's ⇥/↵ rewriter converts it to a tab — as a \\t escape inside a string literal, or as a separate \\t argument in a function call."},
    {"text": "↵", "label": "NL", "desc": "newline — pastes ↵ (U+21B5); the DSL turns it into a newline", "detail": "Inserts the newline glyph ↵. The DSL's ⇥/↵ rewriter converts it to a newline. The button shows 'NL' because the ↵ glyph does not render in this font."}
   ]}
  ]}
 ]
}
