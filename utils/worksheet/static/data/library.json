    {"text": "≤", "desc": "less than or equal"},
    {"text": "≥", "desc": "greater than or equal"},
    {"text": "=", "desc": "assignment in default DSL mode; use ≟, ＝ or == to compare, and ≡ or Eq(...) for symbolic equations"}
   ]},
   {"heading": "Logic", "entries": [
    {"text": "∧", "desc": "logical and — DSL rewrites to Python 'and'"},
    {"text": "∨", "desc": "logical or — rewrites to 'or'"},
    {"text": "¬", "desc": "logical not — rewrites to 'not'"}
   ]},
   {"heading": "Powers, roots, exponents", "entries": [
    {"text": "↑", "desc": "power arrow — math-textbook notation for exponent; 2 ↑ 10 = 1024 (rewrites to **)"},
    {"text": "²", "desc": "superscript 2 — postfix square in DSL: x² = x**2"},
