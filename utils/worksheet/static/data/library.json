    {"text": "m_e", "desc": "electron mass ≈ 9.109 × 10⁻³¹ kg"},
    {"text": "mₑ", "desc": "electron mass (subscript form — same as m_e)"},
    {"text": "m_p", "desc": "proton mass ≈ 1.673 × 10⁻²⁷ kg"},
    {"text": "mₚ", "desc": "proton mass (subscript form — same as m_p)"},
    {"text": "m_n", "desc": "neutron mass ≈ 1.675 × 10⁻²⁷ kg"},
    {"text": "Faraday", "desc": "Faraday constant = N_A · q_e ≈ 96 485 C/mol (F is the farad; F_c is an alias)"},
    {"text": "α_fs", "desc": "fine-structure constant ≈ 7.297 × 10⁻³ (dimensionless; alpha_fs is an alias)"},
    {"text": "a_0", "desc": "Bohr radius ≈ 52.92 pm"},
    {"text": "μ_B", "desc": "Bohr magneton ≈ 9.274 × 10⁻²⁴ J/T"},
    {"text": "Z_0", "desc": "impedance of free space ≈ 376.73 Ω (= μ_0·c)"},
    {"text": "R_∞", "desc": "Rydberg constant ≈ 1.097 × 10⁷ /m (R_inf in Python)"},
    {"text": "b_wien", "desc": "Wien displacement constant ≈ 2.898 × 10⁻³ m·K"}
   ]},
   {"heading": "Astronomical / astrophysical", "entries": [
    {"text": "au", "desc": "astronomical unit ≈ 1.496 × 10¹¹ m — mean Sun-Earth distance"},
    {"text": "ly", "desc": "light-year ≈ 9.461 × 10¹⁵ m"},
    {"text": "parsec", "desc": "parsec ≈ 3.086 × 10¹⁶ m — distance at which 1 au subtends 1″"},
    {"text": "M_sun", "desc": "solar mass ≈ 1.988 × 10³⁰ kg"},
    {"text": "M_earth", "desc": "Earth mass ≈ 5.972 × 10²⁴ kg"},
