  {"name": "Matrix", "sections": [
   {"heading": "Construction", "entries": [
    {"text": "[[1,2],[3,4]]", "desc": "a 2×2 matrix literal — list-of-lists is a real matrix"},
    {"text": "[[1,2,3],[4,5,6]]", "desc": "a 2×3 matrix; rows must be equal length"},
    {"text": "[[1],[2],[3]]", "desc": "a column vector (3×1)"}
   ]},
   {"heading": "Operations", "entries": [
    {"text": "ᵀ", "desc": "transpose — append to a matrix: Mᵀ"},
    {"text": ".det()", "desc": "determinant — M.det()"},
    {"text": ".inv()", "desc": "inverse — M.inv()"},
    {"text": ".T", "desc": "transpose (function form); same as the ᵀ superscript"},
    {"text": ".eigenvals()", "desc": "eigenvalues as {value: multiplicity}"},
    {"text": ".rank()", "desc": "rank of the matrix"},
    {"text": ".trace()", "desc": "sum of the diagonal"},
    {"text": "M⁻¹", "desc": "inverse via the superscript — M⁻¹ is M.inv(); M² is M·M"},
    {"text": "|M|", "desc": "determinant via bars — |M| is M.det() (norm for a row/column vector)"},
    {"text": "det()", "desc": "determinant, function form"},
    {"text": "eye()", "desc": "identity matrix — eye(3)"},
    {"text": "zeros(, )", "desc": "zero matrix — zeros(rows, cols); also ones(, ), diag(, , )"}
