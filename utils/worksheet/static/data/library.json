    {"text": "R_sun", "desc": "solar radius ≈ 6.957 × 10⁸ m"},
    {"text": "R_earth", "desc": "Earth equatorial radius ≈ 6.371 × 10⁶ m"}
   ]},
   {"heading": "Engineering reference values", "entries": [
    {"text": "g_0", "desc": "standard gravity = 9.806 65 m/s² (exact, by CGPM 1901 definition; defined in extra_units)"},
    {"text": "g_n", "desc": "alternate spelling for g_0 (older physics-textbook convention)"},
    {"text": "gₙ", "desc": "standard gravity (subscript-n form — same as g_n)"},
    {"text": "T_0", "desc": "ice point = 273.15 K (defined)"},
    {"text": "Tₒ", "desc": "ice point (subscript-o form — same as T_0)"},
    {"text": "p_0", "desc": "standard atmosphere = 101 325 Pa (exact)"},
    {"text": "20 °C", "desc": "room temperature as an absolute-temperature literal (293.15 K)"}
   ]}
  ]},
  {"name": "Symbolic", "sections": [
   {"heading": "Declarations", "entries": [
    {"text": "symbols: ", "desc": "declare sympy symbols — symbols: x, y, R1..R4 (ranges expand; R₁ registers a subscripted name)"},
    {"text": "positive_symbols: ", "desc": "declare symbols assumed positive"},
    {"text": "real_symbols: ", "desc": "declare symbols assumed real"},
    {"text": "integer_symbols: ", "desc": "declare symbols assumed integer"}
   ]},
   {"heading": "Symbolic algebra", "entries": [
    {"text": "simplify()", "desc": "simplify a symbolic expression"},
    {"text": "expand()", "desc": "expand products and powers; opposite of factor"},
    {"text": "factor()", "desc": "factor a polynomial expression"},
    {"text": "solve(, )", "desc": "solve an equation or system — solve(x² ≡ 4, x)"},
    {"text": "solve([ ≡ ,  ≡ ], [, ])", "desc": "solve a system — solve([x + y ≡ 3, x − y ≡ 1], [x, y])"},
    {"text": "nsolve(, , )", "desc": "numeric root — nsolve(expr, var, guess); DSL numbers accepted as the guess"},
    {"text": "diff()", "desc": "symbolic derivative; diff(expr, variable) — or ∂(expr, x)"},
    {"text": "integrate()", "desc": "symbolic integral; (expr, var) or (expr, (var, a, b)) — or ∫(expr, x)"},
    {"text": "series()", "desc": "Taylor / Laurent series; series(expr, var, point, order)"},
    {"text": "limit()", "desc": "symbolic limit; limit(expr, var, point)"},
    {"text": ".subs(, )", "desc": "substitute symbols; expr.subs(x, value)"},
    {"text": "lambdify(, )", "desc": "turn an expression into a fast numeric function — lambdify(x, expr)"},
    {"text": "latex()", "desc": "LaTeX source of an expression"},
    {"text": "nsimplify()", "desc": "recover exact forms from floats (0.5 → 1/2)"},
    {"text": "Eq()", "desc": "symbolic equation — Eq(lhs, rhs), also written lhs ≡ rhs"},
    {"text": "sym.collect(, )", "desc": "collect terms by powers of a variable (sym. prefix — not re-exported)"},
    {"text": "sym.trigsimp()", "desc": "simplify trigonometric expressions (sym. prefix)"},
    {"text": "sym.expand_trig()", "desc": "expand trig functions of sums (sym. prefix)"},
    {"text": "Symbol()", "desc": "declare a single sympy symbol; x = Symbol('x') (prefer symbols: x)"},
