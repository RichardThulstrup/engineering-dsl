    {"text": "⁻¹", "desc": "inverse — x⁻¹ = 1/x"},
    {"text": "⁻²", "desc": "x⁻² = 1/x²"},
    {"text": "√", "desc": "square root glyph (use as prefix: √2)"},
    {"text": "³√", "desc": "cube root (prefix: ³√27 = 3)"},
    {"text": "∛", "desc": "cube root glyph — same as ³√: ∛27 = 3"},
    {"text": "∜", "desc": "fourth root glyph — same as ⁴√: ∜16 = 2"},
    {"text": "sin⁻¹()", "desc": "inverse function via superscript — sin⁻¹(x) is asin(x); works for cos, tan, sinh, cosh, tanh too"}
   ]},
