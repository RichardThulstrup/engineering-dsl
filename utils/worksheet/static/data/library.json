   ]}
  ]},
  {"name": "Plotting", "sections": [
   {"heading": "Plot", "entries": [
    {"text": "plot(, )", "desc": "plot paired data: plot(x, y). Unit-aware — axis labels follow the data."},
    {"text": "plot()", "desc": "plot y-only — x defaults to the index 0, 1, 2, …"},
    {"text": "plot(, , (, ))", "desc": "plot a symbolic expression swept over a range: plot(expr, var, (xmin, xmax))."},
    {"text": "plot(, , fit=1)", "desc": "overlay a linear fit on the first paired-data series (fit=2 quadratic, etc.)."},
    {"text": "plot(, , theme=\"darkgrid\")", "desc": "per-plot style — applied locally, does not affect later plots."},
    {"text": ", (\"label\", \"o\")", "desc": "series label + matplotlib style string — 'o' markers, '--' dashed, …"},
    {"text": "return_ax=True", "desc": "make plot() return the matplotlib Axes for further customisation."},
    {"text": "plot(, [ ± ,  ± ] )", "desc": "a series of ± values draws error bars: plot(x, [1.0 ± 0.1, 2.1 ± 0.2] V)"}
   ]},
   {"heading": "Axes options", "entries": [
    {"text": "logx=True", "desc": "logarithmic x axis"},
    {"text": "logy=True", "desc": "logarithmic y axis"},
    {"text": "loglog=True", "desc": "both axes logarithmic"},
    {"text": "grid=True", "desc": "draw a grid (minor lines too on a log axis)"},
    {"text": "xlim=(, )", "desc": "x-axis limits — unit-carrying ends are fine: xlim=(1 Hz, 100 kHz)"},
    {"text": "ylim=(, )", "desc": "y-axis limits"},
    {"text": "figsize=(, )", "desc": "figure size in inches — figsize=(6, 3)"},
    {"text": "save=\"\"", "desc": "also save the figure to a file — save=\"plot.png\""}
   ]},
   {"heading": "Bode", "entries": [
    {"text": "bode(, , (, ))", "desc": "Bode plot — bode(H, p, (f_min, f_max)); p is the Laplace variable, replaced by j·2π·f (s is the second, use p)"},
    {"text": "bode(, , (, ), s=False)", "desc": "sweep the variable itself as ω (for an expression written with an explicit i·ω)"}
   ]},
   {"heading": "Fitting", "entries": [
    {"text": "linefit(, )", "desc": "unit-aware linear fit — returns (slope, intercept) as dimensioned quantities."},
    {"text": "polyfit(, , )", "desc": "unit-aware polynomial fit — polyfit(x, y, degree)."}
   ]},
   {"heading": "Themes", "entries": [
    {"text": "list_themes()", "desc": "print every available plot theme alias."},
    {"text": "theme=\"darkgrid\"", "desc": "dark background with a grid"},
    {"text": "theme=\"whitegrid\"", "desc": "light background with a grid"},
    {"text": "theme=\"ggplot\"", "desc": "ggplot-style"},
    {"text": "theme=\"538\"", "desc": "FiveThirtyEight style"},
    {"text": "theme=\"solarized\"", "desc": "Solarized palette"},
    {"text": "theme=\"paper\"", "desc": "muted, print-friendly"},
    {"text": "theme=\"presentation\"", "desc": "large elements for slides"},
    {"text": "theme=\"colorblind\"", "desc": "colourblind-safe palette"}
   ]},
   {"heading": "Axis labels via ▸", "entries": [
    {"text": "plot(, y ▸ μm)", "desc": "display that axis in a chosen unit (μm here)."},
    {"text": "plot(expr, t ▸ ms, (, ))", "desc": "label a symbolic sweep axis — t ▸ ms gives a 't [ms]' axis, no conversion."},
    {"text": "plot(x ▸ \"element\", )", "desc": "a bare string labels an axis that has no physical unit (a count, an index)."}
   ]}
  ]},
  {"name": "ISO 286", "sections": [
   {"heading": "Tolerance bands", "entries": [
    {"text": "hole(, \"H7\")", "desc": "hole tolerance band as a Range of mm — hole(nominal, class). e.g. hole(25, \"H7\")."},
    {"text": "shaft(, \"g6\")", "desc": "shaft tolerance band as a Range of mm — shaft(nominal, class). e.g. shaft(25, \"g6\")."}
   ]},
   {"heading": "Fit analysis", "entries": [
    {"text": "fit(, \"H7\", \"g6\")", "desc": "analyse a pairing — fit(nominal, hole_class, shaft_class). Classifies clearance / transition / interference."},
    {"text": ".kind", "desc": "fit kind — 'clearance', 'transition' or 'interference'."},
    {"text": ".min_clearance", "desc": "smallest clearance (negative = interference)."},
    {"text": ".max_clearance", "desc": "largest clearance."}
   ]},
   {"heading": "Tolerance formulas", "entries": [
    {"text": "it_grade(, )", "desc": "IT-grade band width — it_grade(diameter, grade). e.g. it_grade(25, 7)."},
    {"text": "tolerance_unit()", "desc": "the standard tolerance unit i for a given diameter."}
   ]},
   {"heading": "Common classes", "entries": [
    {"text": "\"H7\"", "desc": "hole basis, grade 7 — the usual reference hole."},
    {"text": "\"H8\"", "desc": "hole basis, grade 8 — a looser reference hole."},
    {"text": "\"g6\"", "desc": "shaft, slight clearance — H7/g6 is a precise running fit."},
    {"text": "\"h6\"", "desc": "shaft basis, grade 6 — zero upper deviation."},
    {"text": "\"k6\"", "desc": "shaft, transition — H7/k6 may clear or interfere."},
    {"text": "\"p6\"", "desc": "shaft, interference — H7/p6 is a press fit."},
    {"text": "\"f7\"", "desc": "shaft, free running clearance."}
   ]}
  ]},
